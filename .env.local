# ── Google Cloud OAuth Configuration ──────────────────────────────────────────
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth 2.0 Client ID" with type "Web Application"
# 3. Add Authorized JavaScript Origins:
#    - http://localhost:3000
#    - (Add your production frontend domain here when deploying)
# 4. Copy the Client ID and set both environment variables below:

# Backend Google Client ID (used to verify incoming Google ID Tokens)
GOOGLE_CLIENT_ID=686335079814-eop6jc17vai2eqc7564e1prvqfn5bn0k.apps.googleusercontent.com

# Frontend Google Client ID (used to initialize Google Identity Services button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=686335079814-eop6jc17vai2eqc7564e1prvqfn5bn0k.apps.googleusercontent.com

# ── Backend Database & Security Variables ──────────────────────────────────────
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/demo_db
DB_USERNAME=javaproj
DB_PASSWORD=Javaproj123
JWT_SECRET=resume-builder-super-secret-key-32chars!
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
GLM_API_KEY=your_zhipuai_api_key

# ── Frontend API Base URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
